<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EEEEEE"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/pharmacyIconIv"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_dialog_map"
            app:tint="@color/primary"
            android:background="#F0F4F8"
            android:padding="8dp"
            android:contentDescription="Pharmacy Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/pharmacyNameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pharmacy Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/onBackground" />

            <TextView
                android:id="@+id/pharmacyDetailsTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.5km away • Open 24/7"
                android:textSize="12sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/pharmacyRatingTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.5"
                android:textSize="12sp"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/callIv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_call"
            app:tint="@color/primary"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Call Pharmacy" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>